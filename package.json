{
  "name": "lemma",
  "private": true,
  "license": "MIT",
  "author": "sh1lll (https://github.com/sh1lll)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lemma/web",
    "build": "npm run typecheck && npm run corpus && npm run build -w @lemma/extension && npm run build -w @lemma/web && node scripts/copy-extension.mjs && node scripts/check-bundle.mjs",
    "preview": "npm run preview -w @lemma/web",
    "test": "vitest run",
    "corpus": "vitest run packages/runtime/test/corpus",
    "corpus:symbolic": "playwright test e2e/corpus-symbolic.spec.ts --project=chromium",
    "bench": "vitest run packages/math-core/test/perf.test.ts --silent=false",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "desktop": "npm run build && npm start -w @lemma/desktop",
    "desktop:dist": "npm run build && npm run dist -w @lemma/desktop",
    "desktop:smoke": "npm run build && LEMMA_SMOKE=1 npm start -w @lemma/desktop",
    "e2e": "npm run build && playwright test",
    "icons": "node scripts/render-icons.mjs",
    "icons:mobile": "node scripts/render-mobile-assets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "playwright": "^1.56.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
