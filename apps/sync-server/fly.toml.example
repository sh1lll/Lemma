# Copy to fly.toml, set `app`, then: fly launch --no-deploy && fly volumes create lemmasync_data --size 1 && fly deploy
app = "your-lemma-sync"
primary_region = "iad"

[build]
  dockerfile = "Dockerfile"

[env]
  TRUST_PROXY = "1"
  ALLOWED_ORIGINS = "https://lemma.app,capacitor://localhost,https://localhost,lemma://app"

[mounts]
  source = "lemmasync_data"
  destination = "/data"

[http_service]
  internal_port = 8787
  force_https = true
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0

  [[http_service.checks]]
    method = "GET"
    path = "/healthz"
    interval = "30s"
    timeout = "3s"
