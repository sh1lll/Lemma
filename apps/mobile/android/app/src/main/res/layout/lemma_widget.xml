<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget. RemoteViews-safe views only (LinearLayout / ImageView / TextView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_brand"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_brand_ripple"
        android:contentDescription="@string/widget_open_content_description"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_lemma_mark" />

    <TextView
        android:id="@+id/widget_calculate"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_primary"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_calculate"
        android:textColor="@color/lemma_bg"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/widget_speak"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_button_secondary"
        android:contentDescription="@string/widget_speak_content_description"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_mic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="sans-serif-medium"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:text="@string/widget_speak"
            android:textColor="@color/lemma_coral"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
